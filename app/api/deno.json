{
  "deploy": {
    "org": "metapage",
    "app": "container"
  },
  "minimumDependencyAge": "0",
  "name": "@metapages/compute-queues-api",
  "exports": {},
  "tasks": {
    "start": "deno run -A --config deno.json src/server.ts"
  },
  "fmt": {
    "exclude": [
      "dist",
      "README.md",
      "*.json",
      "*.lock"
    ],
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "imports": {
    "@/": "./src/",
    "@shared/": "../shared/src/shared/"
  }
}