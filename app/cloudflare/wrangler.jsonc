// container.mtfm.io API + browser app on Cloudflare. Built by `just cloudflare build`
// (deno bundle → dist/worker.js; browser + docs → .assets). See issue #308.
{
  "$schema": "https://unpkg.com/wrangler@4.151.3/config-schema.json",
  "name": "compute-queues",
  "main": "dist/worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-10-01",
  // process.env (read by getEnv) is populated from vars and secrets under nodejs_compat
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".assets",
    "binding": "ASSETS",
    // /docs/guide/x → x.html (VitePress cleanUrls)
    "html_handling": "auto-trailing-slash",
    // only applies to env.ASSETS.fetch from the Worker: missing docs get docs/404.html
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [{ "name": "QUEUES", "class_name": "QueueDurableObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QueueDurableObject"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "compute-queues", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    // R2 over its S3 API. Secrets: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT
    "AWS_REGION": "auto",
    "AWS_S3_BUCKET": "compute-queues"
  },
  "env": {
    "staging": {
      "name": "compute-queues-staging",
      // https://compute-queues-staging.<account subdomain>.workers.dev until there is a staging domain
      "workers_dev": true,
      "durable_objects": {
        "bindings": [{ "name": "QUEUES", "class_name": "QueueDurableObject" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QueueDurableObject"] }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "compute-queues-staging",
          "database_id": "3733bd14-a6e5-43fd-b41d-fea6f4531310"
        }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "AWS_REGION": "auto",
        "AWS_S3_BUCKET": "compute-queues-staging"
      }
    }
  }
}
